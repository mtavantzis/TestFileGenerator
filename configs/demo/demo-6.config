[settings]
outputPath=demo-6
rowCount=3

[fields]
row_number = rowNumber()
company = sample("companies.name")
first_name = sample("users.first_name")
last_name = sample("users.last_name")
email = sample("users.email")

[templatefile]
fileName=nested-templates.txt

[header]
== I am the header ==

[row]
== Start Row [row_number] ==
First Name: [first_name]
Last Name: [last_name]
email: [email]
company: [company]
Nested Items >>>
{ nested : 1-2}
== End Row [row_number]

[nested]
	Nested First Name: [first_name]
	Nested Last Name: [last_name]
	Nested Email: [email]

[footer]
== I am the footer ==

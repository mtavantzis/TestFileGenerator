[settings]
outputPath=demo-7
rowCount=1000

[fields]
boolean = set("true", "false")
chat_id = "cid-" + leftPad(intRange(1,9999), 4, "0")
company = sample("companies.name")
content = randomWord(2,10)
count = intRange(0,1000000)
country = sample("countries.name")
country_code = sample("countries.code")
date = dateRange("2011-01-01","2017-01-01","yyyy-MM-dd'T'HH:mm:ssZ")
department = sample("departments")
device_type = set("Desktop PC", "Tablet", "Smartphone")
email = sample("users.email")
extension = sample("extensions")
file_name = randomWord(1,1) + "-" + randomWord(1,1) + "." + sample("extensions")
file_size = intRange(1000,10000000)
hash = randomText(32,32,"hex")
ip = intRange(1,255) + "." + intRange(1,255) + "." + intRange(1,255) + "." + intRange(1,255)
message_id = randomText(32,32,"hex") + "." + sample("users.email")
message_type = set("email", "note", "calendar")
phone_number = "555-" + leftPad(intRange(0,999), 3, "0") + "-" + leftPad(intRange(0,9999), 4, "0")
room_id = "Room-" + intRange(1,1000)
room_name = randomWord(1,1) + " " + intRange(1,9)
row_number = rowNumber()
subject = randomWord(1,3)
user_first_name = sample("users.first_name")
user_full_name = sample("users.full_name")
user_id = sample("users.id")
user_last_name = sample("users.last_name")
uuid = uuid()


[structuredfile]
fileName=all_fields.csv
includeHeader=true
separator=,
textQualifier="
fields=all


[settings]
outputPath=autobahnfx
rowCount=10

[fields]
date_start=@date_start
date_end=@date_end
user_email=sample("users.email")
message_time=drng(@date_start, @date_end, "yyyy-MM-dd HH:mm:ss")
message_id = "FXOP" + randt(8,8,"hex")
ti_quote_id = "FXOP" + randt(8,8,"hex")
pricing_session_id = randt(12,12,"numeric")
attribute_time=drng([message_time], @date_end, "yyyy-MM-dd HH:mm:ss")
sales_feedback_text=randw(5,20)
comment_text=randw(10,40)
date_folder = formatDate(@date_end,"yyyy-MM-dd'T'HHmmss'Z'")
file_name = "abfx_quotes_" + formatDate(@date_end,"yyyyMMdd_HHmmss")

[templatefile]
fileName=[date_folder]/[file_name].xml

[header]
<?xml version='1.0' encoding='UTF-8' ?>
<messages>

[sales]
<sales>[user_email]</sales>

[salesfeedback]
<salesFeedback>
    <feedback time="[attribute_time]" user="[user_email]">[sales_feedback_text]</feedback>
</salesFeedback>
<traderFeedback/>

[comment]
<comment time="[attribute_time]" user="[user_email]">
    [comment_text]
</comment>

[row]
<message>
{ sales : 1 }
<trader>[user_email]</trader>
<time>[message_time]</time>
<tradeId>[message_id]</tradeId>
<tiQuoteId>[ti_quote_id]</tiQuoteId>
<pricingSessionId>[pricing_session_id]</pricingSessionId>
<messageId>[message_id]</messageId>
{ salesfeedback : 0-1 }
<comments>
    { comment : 1-3 }
</comments> 
</message>

[footer]
</messages>

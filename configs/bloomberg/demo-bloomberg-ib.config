[settings]
outputPath=bloomberg
publicKeyPath=symphonytest.pkr
postPackageProcesses=encrypt
rowCount=20

[fields]
row_number=rnum()
date_start=@date_start
date_end=@date_end
format_version="IBXML 1.3"
conversation_id="CHAT-fs:" + randt(16,16,"hex")
start_time=format(@date_start, "MM/dd/YYYY HH:mm:ss")
start_time_epoch=format(@date_start, "epoch")
end_time=format(@date_end, "MM/dd/YYYY HH:mm:ss")
end_time_epoch=format(@date_end, "epoch")
user_login_name=upper(sample("users.first_name") + "." + sample("users.last_name"))
user_first_name=upper(sample("users.first_name"))
user_last_name=upper(sample("users.last_name"))
user_id=int(replace(sample("users.id"),"UID",""))
user_organization=escape(sample("users.organization"),"xml11")
user_email=sample("users.email")
bloomberg_uuid=int(replace(sample("users.id"),"UID",""))
bloomberg_email=lower(sample("users.first_name")) + "." + lower(sample("users.last_name")) + ".test1000" + "@bloomberg.net"
user_firm_number="1000"
user_account_number="1001"
message_content=escape(randw(5,20), "xml11")
event_date=drng(@date_start,@date_end, "YYYY-MM-dd HH:mm:ss")
event_date_text=format([event_date], "MM/dd/YYYY HH:mm:ss")
event_date_utc=format([event_date],  "epoch")
ib_file_name = @feed_id + ".ib." + format(@date_end, "YYMMdd")
attachment_file_id = counter("attachment_file.file_count") + "." + sample("mimetypes.extension")
attachment_file_ref = "bloomberg_attachments_" + format(@date_end, "YYMMdd") + "/" + [attachment_file_id]
attachment_file_name = randw(1,1) + "." + sample("mimetypes.extension")
attachment_package_name = @feed_id + ".att." + format(@date_end, "YYMMdd")

[outputfile]
name=attachment_file
fileName=[attachment_file_ref]
packageName=[attachment_package_name].tar.gz
create=per reference

[templatefile]
fileName=[attachment_package_name].done

[header]
done

[templatefile]
fileName=[ib_file_name].done

[header]
done

[templatefile]
fileName=[ib_file_name].xml

[header]
<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<FileDump>
<Version>[format_version]</Version>

[row]
<Conversation Perspective=" " RoomType="C">
<RoomID>[conversation_id]</RoomID>
<StartTime>[start_time]</StartTime>
<StartTimeUTC>[start_time_epoch]</StartTimeUTC>
{participant_entered|participant_left:2}
{message:1-3}
{attachment:0-1}
</Conversation>

[message]
<Message InteractionType="N">
{user:1}
<DateTime>[event_date_text]</DateTime>
<DateTimeUTC>[event_date_utc]</DateTimeUTC>
<Content>[message_content]</Content>
<ConversationID>[^row^conversation_id]</ConversationID>
</Message>

[user]
<User>
<LoginName>[user_login_name]</LoginName>
<FirstName>[user_first_name]</FirstName>
<LastName>[user_last_name]</LastName>
<UUID>[user_id]</UUID>
<FirmNumber>[user_firm_number]</FirmNumber>
<AccountNumber>[user_account_number]</AccountNumber>
<CompanyName>[user_organization]</CompanyName>
<EmailAddress>[bloomberg_email]</EmailAddress>
<CorporateEmailAddress>[user_email]</CorporateEmailAddress>
</User>

[participant_entered]
<ParticipantEntered InteractionType="N">
{user:1}
<DateTime>[event_date_text]</DateTime>
<DateTimeUTC>[event_date_utc]</DateTimeUTC>
<ConversationID>[^row^conversation_id]</ConversationID>
</ParticipantEntered>

[participant_left]
<ParticipantLeft InteractionType="N">
{user:1}
<DateTime>[event_date_text]</DateTime>
<DateTimeUTC>[event_date_utc]</DateTimeUTC>
<ConversationID>[^row^conversation_id]</ConversationID>
</ParticipantLeft>

[attachment]
<Attachment InteractionType = "N">
{user:1}
<DateTime>[event_date_text]</DateTime>
<DateTimeUTC>[event_date_utc]</DateTimeUTC>
<ConversationID>[^row^conversation_id]</ConversationID>
<FileName>[attachment_file_name]</FileName>
<FileID>[attachment_file_id]</FileID>
<FileSize>[attachment_file.size]</FileSize>
</Attachment>

[footer]
</FileDump>

[settings]
outputPath=examples-template-counters
rowCount=3

[fields]
message_id = "MID-" + randt(16,16,"hex")
message_content = randw(10,32)
chat_id = "C" + lpad(rnum(), 8, "0")
event_id = "E" + lpad(counter("event.total_count"), 8, "0")

[templatefile]
fileName=template-counters.xml

[header]
<Chats>

[row]
	<Chat eventCount="[counters.event.count]">
		<ID>[chat_id]</ID>
		<Events>
			{event:1-3}
		</Events>
[event]
			<Event messageCount="[counters.message.count]">
				<ID>[event_id]</ID>
				<Messages>
					{ message: 1-5 }
				</Messages>
			</Event>

[message]
					<Message>
						<ID>[message_id]</ID>
						<Content>[message_content]</Content>
					</Message>

[footer]
</Chats>

[settings]
outputPath=MG
rowCount=250
filepoolpath=filepool

[fields]
#email_date = drng(@date_start, @date_end,"E, dd MMM yyyy HH:mm:ss Z")

messagetime = drng(@date_start, @date_end,"yyyy-MM-dd") + "T" + drng(@date_start, @date_end,"HH:mm:ss") + "Z"

#user_name = sample("Enron_LDIF-DICTIONARY_.cn")
#full_name = sample("Enron_LDIF-DICTIONARY_.givenName")
#user_email = sample("Enron_LDIF-DICTIONARY_.mail")
#user_department = sample("Enron_LDIF-DICTIONARY_.departmentnumber")
#user_phone = sample("Enron_LDIF-DICTIONARY_.uid")

#user_id = sample("Enron_LDIF-DICTIONARY_.uid")
#status = sample("Enron_LDIF-DICTIONARY_.zantazsuper")
#region = sample("Enron_LDIF-DICTIONARY_.departmentnumber")
phone = "+1" + " " + upper(randt(3,3,"numeric")) + " " + upper(randt(3,3,"numeric")) + " " + upper(randt(4,4,"numeric"))
ban = upper(randt(8,9,"numeric"))
sipfrom = upper(randt(11,11,"numeric")) + "@" + randw(1,1) + ".onsip.com"
sipto = upper(randt(11,11,"numeric")) + "@" + randw(1,1) + ".onsip.com"
#hire_date = drng("2011-01-01","2022-06-01","MM/dd/yyyy")
#mod_date = drng("2022-06-02","2022-06-15","MM/dd/yyyy")

#subject = sample("ubs_test.SUBJECT")
message_key = upper(randt(32,32,"alpha-numeric"))
#message_id = "<" + [message_key] + "." + sample("test_users_demo.email") + ">;"
#boundary = "PART_" + [message_key]
boundary = "RCSE_POL01_" + [message_key]
#related_boundary = "REL_" + [message_key]

msisdn = "+1" + sample("testphones.phone")	
from = "+1" + 55512345 + upper(randt(2,2,"numeric"))
messageid = upper(randt(12,12,"alpha-numeric")) + "-" + upper(randt(4,4,"alpha-numeric")) + "-" + upper(randt(4,4,"alpha-numeric")) + "-" + upper(randt(4,4,"alpha-numeric")) + "-" + upper(randt(12,12,"alpha-numeric"))
conversationid = upper(randt(16,16,"alpha-numeric"))
contributionid = upper(randt(16,16,"alpha-numeric"))
inreplytocontributionid = upper(randt(7,7,"alpha-numeric"))

file_name = "email." + lpad(rnum(),6,"0") + ".eml"
#file_name_particiant = [file_name] + ".json"
#file_name_particiant_pm = [file_name_particiant] + ".pm"
#file_name_particiant_dr = [file_name] + ".dr"
#file_name_inscope = [file_name] + ".is"
content1 = sample("s_content.content") 

#attachment_extension = sample("enronmimetypes.extension")
#mimetype = sample("enronmimetypes.name")
#attachment_name = randw(1,1) + "." + [attachment_extension]
#attachment_content = poolFileBase64([attachment_extension])


[templatefile]
fileName=[file_name]
[row]
{
POST /ArchivalPath HTTP/1.1
Accept: */*
Host: PartnerFQDN
authorization: Basic dGVzdDpwYXNzd29yZA==
X-Phone-Number: [phone]
X-BAN-Number: [ban]
Content-Type: multipart/form-data; boundary=[boundary]
Content-Length: 1500
--[boundary]

Content-Type: application/json
{
"object": {
"parentFolderPath": "{folderpath}",
"attributes": {
"attribute": [{
"name": "From",
"value": ["sip:+[sipfrom]"]
}, {
"name": "To",
"value": ["sip:+[sipto"]
}, {
"name": "Date",
"value": ["[messagetime]"]
}, {
"name": "Conversation-ID",
"value": ["[conversationid]"]
}, {
"name": "Contribution-ID",
"value": ["[contributionid]"]
}, {
"name": "InReplyTo-Contribution-ID",
"value": ["hb4FRhK"]
}, {
"name": "P-Asserted-Service",
"value": ["urn:urn-7:3gpp-service.ims.icsi.oma.cpm.largemsg"]
}, {
"name": "IMDN-Message-ID",
"value": ["GOdcbIhb4F"]
}, {
"name": "Message-ID",
"value": ["101e0a06-1-5751c1d4-39976"]
}, {
"name": "Direction",

"value": ["In"]
}, {
"name": "X-DateTime",
"value": ["1464975831"]
}, {
"name": "X-SIP-CallId",
"value": ["00001000000001146497583"]
}, {
"name": "Message-Context",
"value": ["X-RCS-LM"]
}, {
"name": "Content-Type",
"value": ["multipart/mixed "]
},
{
"name": "CPIM",
"value": ["From: MR SANDERS <im:piglet@100akerwood.com>\r\nTo: Dopey Donkey <im:eeyore@100akerwood.com>\r\nDateTime: 2014-12-13T13:40:00-08:00\r\nSubject: the weather will be fine today\r\nSubject:;lang=fr beau temps prevu pour aujourd'hui\r\nNS: MyFeatures <mid:MessageFeatures@id.foo.com>\r\nRequire: MyFeatures.VitalMessageOption\r\nMyFeatures.VitalMessageOption: Confirmation-requested\r\nMyFeatures.WackyMessageOption: Use-silly-font"]
}]
},
"flags": {
"flag": [
"\\Recent"
]
}
}
}
--[boundary]
Content-Disposition: form-data; name=attachments


Content-Type: multipart/mixed; boundary=7fekyzC-uQhXhZCGky5kU7wP
--7fekyzC-uQhXhZCGky5kU7wP
Content-Disposition: attachment; filename=body.txt; name=body.txt
Content-Type: text/plain; charset=UTF-8
See attached photo
--7fekyzC-uQhXhZCGky5kU7wP
Content-Disposition: attachment; filename=picture.gif; name=picture.gif
Content-Type: image/gif
[base64 Data]
--7fekyzC-uQhXhZCGky5kU7wP--
--[boundary]--

"subscriberID": "N_NBI_033_999999999999999999999",
"msisdn": "[msisdn]",
"ban": "101010101010",
"messageId": "[messageid]",
"messageContext": "pager-message",
"messageTime": "[messagetime]",
"from": "[from]",
"to": ["[msisdn]"],
"groupMessage": false,
"contentType": "text/plain",
"textContent": "[content1]",
"textSize": 8,
"direction": "In"
}
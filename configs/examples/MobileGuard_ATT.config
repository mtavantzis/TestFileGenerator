#related_boundary = "REL_" + [message_key]

msisdn = "+1" + sample("testphones.phone")	
from = "+1" + 55512345 + upper(randt(2,2,"numeric"))
messageid = upper(randt(12,12,"alpha-numeric")) + "-" + upper(randt(4,4,"alpha-numeric")) + "-" + upper(randt(4,4,"alpha-numeric")) + "-" + upper(randt(4,4,"alpha-numeric")) + "-" + upper(randt(12,12,"alpha-numeric"))


file_name = "email." + lpad(rnum(),6,"0") + ".eml"
#file_name_particiant = [file_name] + ".json"
#file_name_particiant_pm = [file_name_particiant] + ".pm"
#file_name_particiant_dr = [file_name] + ".dr"

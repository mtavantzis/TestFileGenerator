[settings]
outputPath=MG
rowCount=250
filepoolpath=filepool

[fields]
#email_date = drng(@date_start, @date_end,"E, dd MMM yyyy HH:mm:ss Z")

messagetime = drng(@date_start, @date_end,"yyyy-MM-dd") + "T" + drng(@date_start, @date_end,"HH:mm:ss") + "Z"


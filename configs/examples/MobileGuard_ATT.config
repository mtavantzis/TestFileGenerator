#attachment_content = poolFileBase64([attachment_extension])


[templatefile]
fileName=[file_name]
[row]
{
"subscriberID": "N_NBI_033_999999999999999999999",
"msisdn": "[msisdn]",
"ban": "101010101010",
"messageId": "[messageid]",
"messageContext": "pager-message",
"messageTime": "[messagetime]",
"from": "[from]",
"to": ["[msisdn]"],
"groupMessage": false,
"contentType": "text/plain",
"textContent": "[content1]",
"textSize": 8,
"direction": "In"
}